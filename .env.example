# Dán Discord Bot Token của bạn vào đây để Bot tự động đăng nhập ngay khi bật Server
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Application ID / Client ID của Bot (dùng để xoá lệnh / cũ và đăng ký 28 lệnh / mới)
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID

# Cổng chạy Web Dashboard (Mặc định: 3000)
PORT=3000
